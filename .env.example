# -----------------------------------------------------------------------------
# Varsayılan: docker compose / pnpm dev → Postgres + Flyway + Payara (8080)
# Sadece DB: docker compose -f docker-compose.dev.yaml up -d  veya pnpm dev:db
# -----------------------------------------------------------------------------
MODE=development

POSTGRES_DB=accounting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accounting

APP_HTTP_PORT=8080
