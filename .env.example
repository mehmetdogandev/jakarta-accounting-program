# MODE: development = yalnızca DB migrasyonu (Payara yerelde veya docker-compose.dev.yaml)
#       production = Payara imajı da Compose ile build/run edilir
MODE=development

# production profilini etkinleştirir (docker-compose.yaml içindeki `app` servisi)
# Development: boş bırakın veya bu satırı yorumlayın
# COMPOSE_PROFILES=production

# PostgreSQL
POSTGRES_DB=accounting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Compose ağı içindeki hostname (konteynerden konteynere). Yerel Payara → JDBC’de localhost kullanın.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Makinenizden (IDE, psql, GUI): localhost ve yukarıdaki POSTGRES_PORT
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accounting

# Payara HTTP port (production profile)
APP_HTTP_PORT=8080
